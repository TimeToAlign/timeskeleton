{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timetoalign.github.io/timeskeleton/0.2.0/timeskeleton.schema.json",
  "title": "TimeSkeleton document",
  "description": "A set of musical timelines with their structure: axis, children at exact offsets, conversion maps, regions, flow control, compressed Measure Map standard rows and metric hierarchy. The timeline manifest mirrors the eventless payload of timetoalign's Timeline.to_dict(). Numbers follow the BOPP core primitives: a fraction is a [numerator, denominator] pair of integers, an integer is a JSON integer and a float is a JSON number; every coordinate names its unit and its number type, which selects the representation of its value. Version 0.2.0 specifies conversion maps, regions, flow control and measure maps; the metric hierarchy is the one structured member that remains opaque.",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "description": "Document metadata.",
      "properties": {
        "schema_version": {
          "const": "0.2.0",
          "description": "The timeskeleton release this document conforms to."
        },
        "generator": {
          "type": "string",
          "description": "Free-form identification of the software that wrote the document."
        }
      },
      "required": [
        "schema_version"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "description": "The structural content of the document.",
      "properties": {
        "timelines": {
          "type": "object",
          "description": "Top-level timelines keyed by their id. May be empty.",
          "additionalProperties": {
            "$ref": "#/$defs/TimelineManifest"
          }
        }
      },
      "required": [
        "timelines"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "meta",
    "manifest"
  ],
  "additionalProperties": false,
  "$defs": {
    "Fraction": {
      "type": "array",
      "description": "Rational number encoded as numerator and non-zero denominator",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "integer",
          "description": "Numerator, signed integer"
        },
        {
          "type": "integer",
          "minimum": 1,
          "description": "Denominator. Strictly positive to prevent zero-division and negative bases."
        }
      ],
      "items": false
    },
    "FractionNonnegative": {
      "type": "array",
      "description": "Non-negative rational number",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "description": "Numerator, non-negative integer"
        },
        {
          "type": "integer",
          "minimum": 1,
          "description": "Denominator. Strictly positive to prevent zero-division and negative bases."
        }
      ],
      "items": false
    },
    "TimeUnit": {
      "type": "string",
      "description": "The unit of a timeline axis.",
      "enum": [
        "number",
        "floating_measures",
        "whole_note",
        "quarters",
        "ticks",
        "milliseconds",
        "seconds",
        "minutes",
        "samples",
        "frames",
        "pixels",
        "meters",
        "centimeters",
        "millimeters",
        "inches",
        "points"
      ]
    },
    "NumberType": {
      "type": "string",
      "description": "The number type of every coordinate on a timeline axis. It selects the representation of a coordinate's value: int is a JSON integer, float a JSON number, fraction a Fraction pair.",
      "enum": [
        "int",
        "float",
        "fraction"
      ]
    },
    "TimelineClass": {
      "type": "string",
      "description": "The concrete timeline class, one per domain and modality.",
      "enum": [
        "ContinuousLogicalTimeline",
        "ContinuousPhysicalTimeline",
        "ContinuousGraphicalTimeline",
        "DiscreteLogicalTimeline",
        "DiscretePhysicalTimeline",
        "DiscreteGraphicalTimeline"
      ]
    },
    "Coordinate": {
      "type": "object",
      "description": "A position on a timeline axis: the axis unit, the number type, and the value in the representation that number type selects.",
      "properties": {
        "unit": {
          "$ref": "#/$defs/TimeUnit"
        },
        "number_type": {
          "$ref": "#/$defs/NumberType"
        },
        "value": {
          "description": "The position, represented as selected by number_type."
        }
      },
      "required": [
        "unit",
        "number_type",
        "value"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "description": "An integer coordinate.",
          "properties": {
            "number_type": {
              "const": "int"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "description": "A float coordinate.",
          "properties": {
            "number_type": {
              "const": "float"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "description": "An exact fraction coordinate.",
          "properties": {
            "number_type": {
              "const": "fraction"
            },
            "value": {
              "$ref": "#/$defs/Fraction"
            }
          }
        }
      ],
      "discriminator": {
        "propertyName": "number_type"
      }
    },
    "CoordinateNonnegative": {
      "type": "object",
      "description": "A coordinate that cannot lie before the origin of its axis, such as a timeline length.",
      "properties": {
        "unit": {
          "$ref": "#/$defs/TimeUnit"
        },
        "number_type": {
          "$ref": "#/$defs/NumberType"
        },
        "value": {
          "description": "The non-negative position, represented as selected by number_type."
        }
      },
      "required": [
        "unit",
        "number_type",
        "value"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "description": "A non-negative integer coordinate.",
          "properties": {
            "number_type": {
              "const": "int"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "description": "A non-negative float coordinate.",
          "properties": {
            "number_type": {
              "const": "float"
            },
            "value": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "description": "A non-negative exact fraction coordinate.",
          "properties": {
            "number_type": {
              "const": "fraction"
            },
            "value": {
              "$ref": "#/$defs/FractionNonnegative"
            }
          }
        }
      ],
      "discriminator": {
        "propertyName": "number_type"
      }
    },
    "TimelineManifest": {
      "type": "object",
      "description": "The structure of one timeline without its events. The axis is unit and number_type; length and every child offset are coordinates on that axis and carry the same unit and number type.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The timeline id, unique within its document."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable name, or null when none was given."
        },
        "class": {
          "$ref": "#/$defs/TimelineClass"
        },
        "unit": {
          "$ref": "#/$defs/TimeUnit"
        },
        "number_type": {
          "$ref": "#/$defs/NumberType"
        },
        "length": {
          "$ref": "#/$defs/CoordinateNonnegative",
          "description": "The end of the timeline on its own axis."
        },
        "locked": {
          "type": "boolean",
          "description": "Whether the timeline refuses to expand."
        },
        "meta": {
          "type": "object",
          "description": "Free-form metadata."
        },
        "children": {
          "type": "object",
          "description": "Child timelines keyed by their id, each placed at an offset on this timeline's axis.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "offset": {
                "$ref": "#/$defs/Coordinate",
                "description": "Where the child's origin lies on this timeline's axis."
              },
              "timeline": {
                "$ref": "#/$defs/TimelineManifest"
              }
            },
            "required": [
              "offset",
              "timeline"
            ],
            "additionalProperties": false
          }
        },
        "conversion_maps": {
          "type": "array",
          "description": "Conversion maps attached to this timeline.",
          "items": {
            "$ref": "#/$defs/ConversionMap"
          }
        },
        "regions": {
          "type": "array",
          "description": "Named regions of this timeline.",
          "items": {
            "$ref": "#/$defs/Region"
          }
        },
        "flow_control": {
          "$ref": "#/$defs/FlowControl"
        },
        "measure_map": {
          "description": "The measure map, or null.",
          "anyOf": [
            {
              "$ref": "#/$defs/MeasureMap"
            },
            {
              "type": "null"
            }
          ]
        },
        "metric_hierarchy": {
          "type": [
            "object",
            "null"
          ],
          "description": "The metric hierarchy, or null. Opaque in 0.1.0: an object without further constraints."
        }
      },
      "required": [
        "id",
        "name",
        "class",
        "unit",
        "number_type",
        "length",
        "locked",
        "meta",
        "children",
        "conversion_maps",
        "regions",
        "flow_control",
        "measure_map",
        "metric_hierarchy"
      ],
      "additionalProperties": false
    },
    "Number": {
      "description": "A bare JSON number or an exact Fraction pair.",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/Fraction"
        }
      ]
    },
    "BeatInMeasureMap": {
      "type": "object",
      "properties": {
        "type": {
          "const": "BeatInMeasureMap"
        },
        "id": {
          "type": "string"
        },
