            },
            {
              "type": "null"
            }
          ]
        },
        "meter_map": {
          "$ref": "#/$defs/MetricMap"
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "source_unit",
        "target_unit",
        "meter_map"
      ],
      "additionalProperties": false
    },
