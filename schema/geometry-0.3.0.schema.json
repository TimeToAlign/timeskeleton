{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timetoalign.github.io/timeskeleton/0.3.0/geometry.schema.json",
  "title": "TimeSkeleton geometry",
  "description": "The drawing of a TimeSkeleton document as laid out by the geometry specification (docs/geometry.md): one block per top-level timeline, each with its frame (its horizontal extent in abstract units), the placement of its root in the frame, its rows and its primitives. Horizontal positions derived from time are exact values on the root timeline's axis; vertical positions are rows or exact fractions of a row. Only writers map them to a page.",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.3.0",
          "description": "The timeskeleton release this geometry conforms to."
        }
      },
      "required": [
        "schema_version"
      ],
      "additionalProperties": false
    },
    "blocks": {
      "type": "array",
      "description": "One block per top-level timeline, in the canonical order of the document's timelines.",
      "items": {
        "$ref": "#/$defs/Block"
      }
    }
  },
  "required": [
    "meta",
    "blocks"
  ],
  "additionalProperties": false,
  "$defs": {
    "Block": {
      "type": "object",
      "description": "The drawing of one top-level timeline.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The id of the root timeline."
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "placement": {
          "allOf": [
            {
              "$ref": "https://timetoalign.github.io/timeskeleton/0.3.0/timeskeleton.schema.json#/$defs/LinearMap"
            },
            {
              "properties": {
                "id": {
                  "const": "placement"
                },
                "target_unit": {
                  "const": "number"
                }
              }
            }
          ],
          "description": "The LinearMap placing the root's coordinates in the plot area: a root position x lies at frame position plot.offset + scalar × x + offset."
        },
        "rows": {
          "type": "object",
          "description": "The lowest and highest row of the block; both include row 0.",
          "properties": {
            "min": {
              "type": "integer",
              "maximum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "background": {
          "$ref": "#/$defs/Colour"
        },
        "primitives": {
          "type": "array",
          "description": "The primitives in drawing order.",
          "items": {
            "$ref": "#/$defs/Primitive"
          }
        }
      },
      "required": [
        "id",
        "frame",
        "placement",
        "rows",
        "background",
        "primitives"
      ],
      "additionalProperties": false
    },
    "Frame": {
      "type": "object",
      "description": "The horizontal extent of a block in abstract units (proportions), its origin at the block's bottom-left corner: its length, the name column (names) and the plot area (plot), where the placement puts the root timeline. Every number is a Fraction pair, or a float when the root's number type is float.",
      "properties": {
        "length": {
          "$ref": "https://timetoalign.github.io/timeskeleton/0.3.0/timeskeleton.schema.json#/$defs/Number",
          "description": "The width of the block."
        },
        "names": {
          "$ref": "#/$defs/Extent"
        },
        "plot": {
          "$ref": "#/$defs/Extent"
        }
      },
      "required": [
        "length",
        "names",
        "plot"
      ],
      "additionalProperties": false
    },
    "Extent": {
      "type": "object",
      "description": "An interval of the frame: where it starts and how long it is.",
      "properties": {
        "offset": {
          "$ref": "https://timetoalign.github.io/timeskeleton/0.3.0/timeskeleton.schema.json#/$defs/Number"
        },
        "length": {
          "$ref": "https://timetoalign.github.io/timeskeleton/0.3.0/timeskeleton.schema.json#/$defs/Number"
        }
      },
      "required": [
        "offset",
        "length"
      ],
      "additionalProperties": false
    },
    "Position": {
      "description": "A position on the root timeline's axis (or, for a label in the frame's space, on the frame's axis): a JSON integer, a JSON float or a Fraction pair.",
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "$ref": "https://timetoalign.github.io/timeskeleton/0.3.0/timeskeleton.schema.json#/$defs/Fraction"
        }
      ]
    },
    "Height": {
      "description": "A vertical position in rows, as an exact Fraction pair in lowest terms.",
      "allOf": [
        {
          "$ref": "https://timetoalign.github.io/timeskeleton/0.3.0/timeskeleton.schema.json#/$defs/Fraction"
        }
      ]
    },
    "Colour": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    },
    "LinePattern": {
      "type": "string",
      "enum": [
        "solid",
        "dotted",
        "dashed"
      ]
    },
    "Side": {
      "type": "string",
      "enum": [
        "above",
        "below"
      ]
    },
    "Anchor": {
      "type": "string",
      "description": "A TikZ node anchor.",
      "enum": [
        "center",
        "north",
        "south",
        "east",
        "west",
        "north east",
        "north west",
        "south east",
        "south west",
        "base",
        "base east",
        "base west",
        "mid",
        "mid east",
        "mid west"
      ]
    },
    "Primitive": {
      "type": "object",
      "description": "One primitive. An open union discriminated by kind: the known kinds are validated by their definitions, and a later version may add kinds that a reader of this version ignores.",
      "properties": {
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "timeline"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/TimelinePrimitive"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "child"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/ChildPrimitive"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "map"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/MapPrimitive"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "region"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/RegionPrimitive"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "break"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/BreakPrimitive"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "jump"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/JumpPrimitive"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wedge"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/WedgePrimitive"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "label"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/LabelPrimitive"
          }
        }
      ]
    },
    "TimelinePrimitive": {
      "type": "object",
      "description": "The line of a root timeline: a filled circle at its start, a stealth at its end.",
      "properties": {
        "kind": {
          "const": "timeline"
        },
        "id": {
          "type": "string",
          "description": "The element id."
        },
        "timeline": {
          "type": "string",
          "description": "The id of the element's timeline."
        },
        "row": {
          "type": "integer",
          "description": "The row: 0 for the root, positive above, negative below."
        },
        "start": {
          "$ref": "#/$defs/Position",
          "description": "Where the line starts."
        },
        "end": {
          "$ref": "#/$defs/Position",
          "description": "Where the line ends."
        },
        "colour": {
          "$ref": "#/$defs/Colour"
        },
        "line_pattern": {
          "$ref": "#/$defs/LinePattern"
        }
      },
      "required": [
        "kind",
        "id",
        "timeline",
        "row",
        "start",
        "end",
        "colour",
        "line_pattern"
      ],
      "additionalProperties": false
    },
    "ChildPrimitive": {
      "type": "object",
      "description": "The line of a child timeline: a filled circle at its start, an open diamond at its end.",
      "properties": {
        "kind": {
          "const": "child"
        },
        "id": {
          "type": "string",
          "description": "The element id."
        },
        "timeline": {
          "type": "string",
          "description": "The id of the element's timeline."
        },
        "row": {
          "type": "integer",
          "description": "The row: 0 for the root, positive above, negative below."
        },
        "start": {
          "$ref": "#/$defs/Position",
          "description": "Where the line starts."
        },
        "end": {
          "$ref": "#/$defs/Position",
          "description": "Where the line ends."
        },
        "colour": {
          "$ref": "#/$defs/Colour"
        },
        "line_pattern": {
          "$ref": "#/$defs/LinePattern"
        }
      },
      "required": [
        "kind",
        "id",
        "timeline",
        "row",
        "start",
        "end",
        "colour",
        "line_pattern"
      ],
      "additionalProperties": false
    },
    "MapPrimitive": {
      "type": "object",
      "description": "A conversion map: a double line closed at both ends.",
      "properties": {
        "kind": {
          "const": "map"
        },
        "id": {
          "type": "string",
          "description": "The element id."
        },
        "timeline": {
          "type": "string",
          "description": "The id of the element's timeline."
        },
        "row": {
          "type": "integer",
          "description": "The row: 0 for the root, positive above, negative below."
        },
        "start": {
          "$ref": "#/$defs/Position",
          "description": "The start of the map's timeline."
        },
        "end": {
          "$ref": "#/$defs/Position",
          "description": "The end of the map's timeline."
        },
        "colour": {
          "$ref": "#/$defs/Colour"
        },
        "line_pattern": {
          "$ref": "#/$defs/LinePattern"
        }
      },
      "required": [
        "kind",
        "id",
        "timeline",
        "row",
        "start",
        "end",
        "colour",
        "line_pattern"
      ],
      "additionalProperties": false
    },
    "RegionPrimitive": {
      "type": "object",
      "description": "A region: a curly brace.",
      "properties": {
        "kind": {
          "const": "region"
        },
        "id": {
          "type": "string",
          "description": "The element id."
        },
        "timeline": {
          "type": "string",
          "description": "The id of the element's timeline."
        },
        "row": {
          "type": "integer",
          "description": "The row: 0 for the root, positive above, negative below."
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "start": {
          "$ref": "#/$defs/Position",
          "description": "The region's start."
        },
        "end": {
          "$ref": "#/$defs/Position",
          "description": "The region's end."
        },
        "base": {
          "$ref": "#/$defs/Height",
          "description": "Where the brace's arms end."
        },
        "apex": {
          "$ref": "#/$defs/Height",
          "description": "Where the brace's tip is."
        },
        "colour": {
          "$ref": "#/$defs/Colour"
        },
        "line_pattern": {
          "$ref": "#/$defs/LinePattern"
        }
      },
      "required": [
        "kind",
        "id",
        "timeline",
        "row",
        "side",
        "start",
        "end",
        "base",
        "apex",
        "colour",
        "line_pattern"
      ],
      "additionalProperties": false
    },
    "BreakPrimitive": {
      "type": "object",
      "description": "A flow-control break: a vertical line through the block.",
      "properties": {
        "kind": {
          "const": "break"
        },
        "id": {
          "type": "string",
          "description": "The element id."
        },
        "timeline": {
          "type": "string",
          "description": "The id of the element's timeline."
        },
        "at": {
          "$ref": "#/$defs/Position",
          "description": "The break's position."
        },
        "bottom": {
          "$ref": "#/$defs/Height",
          "description": "The bottom of the block."
        },
        "top": {
          "$ref": "#/$defs/Height",
          "description": "The top of the block."
        },
        "colour": {
          "$ref": "#/$defs/Colour"
        },
        "line_pattern": {
          "$ref": "#/$defs/LinePattern"
        }
      },
      "required": [
        "kind",
        "id",
        "timeline",
        "at",
        "bottom",
        "top",
        "colour",
        "line_pattern"
      ],
      "additionalProperties": false
    },
    "JumpPrimitive": {
      "type": "object",
      "description": "A flow-control jump: an arc with a stealth at its arrival.",
      "properties": {
        "kind": {
          "const": "jump"
        },
        "id": {
          "type": "string",
          "description": "The element id."
        },
        "timeline": {
          "type": "string",
          "description": "The id of the element's timeline."
        },
        "row": {
          "type": "integer",
          "description": "The row: 0 for the root, positive above, negative below."
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "from": {
          "$ref": "#/$defs/Position",
          "description": "Where the jump leaves."
        },
        "to": {
          "$ref": "#/$defs/Position",
          "description": "Where the jump arrives."
        },
        "base": {
          "$ref": "#/$defs/Height",
          "description": "The height of both ends."
        },
        "apex": {
          "$ref": "#/$defs/Height",
          "description": "The height the arc reaches halfway."
        },
        "colour": {
          "$ref": "#/$defs/Colour"
        },
        "line_pattern": {
          "$ref": "#/$defs/LinePattern"
        }
      },
      "required": [
        "kind",
        "id",
        "timeline",
        "row",
        "side",
        "from",
        "to",
        "base",
        "apex",
        "colour",
        "line_pattern"
      ],
      "additionalProperties": false
    },
    "WedgePrimitive": {
      "type": "object",
      "description": "A coordinate: a wedge whose tip touches the line.",
      "properties": {
        "kind": {
          "const": "wedge"
        },
        "id": {
          "type": "string",
          "description": "The element id."
        },
        "timeline": {
          "type": "string",
          "description": "The id of the element's timeline."
        },
        "row": {
          "type": "integer",
          "description": "The row: 0 for the root, positive above, negative below."
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "at": {
          "$ref": "#/$defs/Position",
          "description": "The coordinate."
        },
        "tip": {
          "$ref": "#/$defs/Height",
          "description": "The height of the tip, on the line."
        },
        "base": {
          "$ref": "#/$defs/Height",
          "description": "The height of the wedge's thick end."
        },
        "colour": {
          "$ref": "#/$defs/Colour"
        }
      },
      "required": [
        "kind",
        "id",
        "timeline",
        "row",
        "side",
        "at",
        "tip",
        "base",
        "colour"
      ],
      "additionalProperties": false
    },
    "LabelPrimitive": {
      "type": "object",
      "description": "A text label: a TikZ-style node at a point, anchored there.",
      "properties": {
        "kind": {
          "const": "label"
        },
        "id": {
          "type": "string",
          "description": "The element id."
        },
        "timeline": {
          "type": "string",
          "description": "The id of the element's timeline."
        },
        "at": {
          "type": "object",
          "properties": {
            "space": {
              "type": "string",
              "enum": [
                "root",
                "frame"
              ],
              "description": "root: x is on the root's axis; frame: x is on the frame's axis."
            },
            "x": {
              "$ref": "#/$defs/Position"
            },
            "y": {
              "$ref": "#/$defs/Height"
            }
          },
          "required": [
            "space",
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "rotate": {
          "type": "number",
          "description": "Counter-clockwise rotation in degrees about at."
        },
        "text": {
          "type": "string"
        },
        "colour": {
          "$ref": "#/$defs/Colour"
        }
      },
      "required": [
        "kind",
        "id",
        "timeline",
        "at",
        "anchor",
        "text",
        "colour"
      ],
      "additionalProperties": false
    }
  }
}
