{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timetoalign.github.io/timeskeleton/0.7.0/timeline.schema.json",
  "title": "TimeSkeleton timeline file",
  "description": "A TimeSkeleton 0.7.0 timeline file: one manifest holding exactly one timeline, with its axis, children at exact offsets (or, in a segment line, contiguous segments), conversion maps, regions, flow control, compressed Measure Map standard rows, opaque metric hierarchy and optional graphical block. Numbers follow the BOPP core primitives: a fraction is a [numerator, denominator] pair of integers, an integer is a JSON integer and a float is a JSON number; every coordinate names its unit and its number type, which selects the representation of its value. Every timeline, conversion map, region, break, jump and marker carries an id, unique within the manifest across all of these kinds; a jump's target is the id of a marker of its own timeline. Object keys carry no order and are written sorted by code point. Arrays whose order carries no meaning have one canonical order: conversion maps by id; regions by start, end, id; breaks and markers by coordinate, then id; jumps by from and to coordinate, then id. Readers accept any order. The graphical block holds named styles and an ordered list of statements, each selecting drawn elements and setting presentation properties named as in SVG; `docs/drawing.md` specifies how a manifest is drawn, and a manifest without the block is drawn with the other style layers alone. The definitions shared with the group and bundle files (numbers, coordinates, units, number types, the id rule, the file metadata and the graphical block) live in core.schema.json; the group and bundle documents refer to this document's TimelineManifest.",
  "type": "object",
  "properties": {
    "meta": {
      "$ref": "core.schema.json#/$defs/Meta"
    },
    "timeline": {
      "$ref": "#/$defs/TimelineManifest"
    },
    "graphical": {
      "$ref": "core.schema.json#/$defs/Graphical"
    }
  },
  "required": [
    "meta",
    "timeline"
  ],
  "additionalProperties": false,
  "$defs": {
    "TimelineClass": {
      "type": "string",
      "description": "The concrete timeline class, one per domain and modality.",
      "enum": [
        "ContinuousLogicalTimeline",
        "ContinuousPhysicalTimeline",
        "ContinuousGraphicalTimeline",
        "DiscreteLogicalTimeline",
        "DiscretePhysicalTimeline",
        "DiscreteGraphicalTimeline"
      ]
    },
    "TimelineManifest": {
      "type": "object",
      "description": "The structure of one timeline without its events. The axis is unit and number_type; length and every child offset are coordinates on that axis and carry the same unit and number type.",
      "properties": {
        "id": {
          "$ref": "core.schema.json#/$defs/Id",
          "description": "The timeline id, unique within its manifest."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable name, or null when none was given."
        },
        "class": {
          "$ref": "#/$defs/TimelineClass"
        },
        "unit": {
          "$ref": "core.schema.json#/$defs/TimeUnit"
        },
        "number_type": {
          "$ref": "core.schema.json#/$defs/NumberType"
        },
        "length": {
          "$ref": "core.schema.json#/$defs/CoordinateNonnegative",
          "description": "The end of the timeline on its own axis."
        },
        "locked": {
          "type": "boolean",
          "description": "Whether the timeline refuses to expand."
        },
        "is_segment_line": {
          "type": "boolean",
          "description": "Whether the timeline is a segment line: a timeline containing only contiguous segments. Its children are its segments, contiguous from 0 in offset order and ending at its length, all of its own class, which is the segments' domain-and-modality class, and all with one is_segment_line value; segments that are segment lines themselves make a nested segment line. Contiguity and homogeneity are checked after the schema."
        },
        "meta": {
          "type": "object",
          "description": "Free-form metadata."
        },
        "children": {
          "type": "object",
          "description": "Child timelines keyed by their id, each placed at an offset on this timeline's axis.",
          "propertyNames": {
            "$ref": "core.schema.json#/$defs/Id"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "offset": {
                "$ref": "core.schema.json#/$defs/Coordinate",
                "description": "Where the child's origin lies on this timeline's axis."
              },
              "timeline": {
                "$ref": "#/$defs/TimelineManifest"
              }
            },
            "required": [
              "offset",
              "timeline"
            ],
            "additionalProperties": false
          }
        },
        "conversion_maps": {
          "type": "array",
          "description": "Conversion maps attached to this timeline.",
          "items": {
            "$ref": "#/$defs/ConversionMap"
          }
        },
        "regions": {
          "type": "array",
          "description": "Regions of this timeline.",
          "items": {
            "$ref": "#/$defs/Region"
          }
        },
        "flow_control": {
          "$ref": "#/$defs/FlowControl"
        },
        "measure_map": {
          "description": "The measure map, or null. A measure map is anchored in quarter notes, so only a timeline whose unit is quarters may carry one.",
          "anyOf": [
            {
              "$ref": "#/$defs/MeasureMap"
            },
            {
              "type": "null"
            }
          ]
        },
        "metric_hierarchy": {
          "type": [
            "object",
            "null"
          ],
          "description": "The metric hierarchy, or null; an object without further constraints."
        }
      },
      "required": [
        "id",
        "name",
        "class",
        "unit",
        "number_type",
        "length",
        "locked",
        "is_segment_line",
        "meta",
        "children",
        "conversion_maps",
        "regions",
        "flow_control",
        "measure_map",
        "metric_hierarchy"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "unit": {
            "const": "quarters"
          }
        },
        "required": [
          "unit"
        ]
      },
      "else": {
        "properties": {
          "measure_map": {
            "type": "null"
          }
        }
      }
    },
    "BeatInMeasureMap": {
      "type": "object",
      "properties": {
        "type": {
